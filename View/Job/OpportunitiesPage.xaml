<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MetanetA_MobileApp.View.Job.OpportunitiesPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MetanetA_MobileApp.Controls"
    xmlns:model="clr-namespace:MetanetA_MobileApp.Model"
    BackgroundColor="#030817">

    <Grid RowDefinitions="*">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#05061A" Offset="0" />
                <GradientStop Color="#061A27" Offset="0.55" />
                <GradientStop Color="#130B24" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="18,22,18,34" Spacing="18">

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Opportunities"
                            FontSize="30"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="{Binding RolesCountText}"
                            FontSize="14"
                            TextColor="#A7B0C3" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        WidthRequest="46"
                        HeightRequest="46"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 23"
                        BackgroundColor="#1A2440"
                        VerticalOptions="Start">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RefreshCommand}" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="↻"
                            FontSize="21"
                            TextColor="#C4B5FD"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>
                </Grid>

                <Border
                    BackgroundColor="#10182B"
                    Stroke="#25314F"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 22"
                    Padding="14,0">
                    <Grid ColumnDefinitions="Auto,*" HeightRequest="52" ColumnSpacing="10">
                        <Label
                            Text="⌕"
                            FontSize="20"
                            TextColor="#7C86A1"
                            VerticalTextAlignment="Center" />
                        <Entry
                            Grid.Column="1"
                            Placeholder="Search roles, skills, seniority"
                            PlaceholderColor="#7C86A1"
                            Text="{Binding SearchText}"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            FontSize="14" />
                    </Grid>
                </Border>

                <ActivityIndicator
                    IsVisible="{Binding IsBusy}"
                    IsRunning="{Binding IsBusy}"
                    Color="#7C3AED"
                    HeightRequest="42" />

                <Border
                    IsVisible="{Binding HasError}"
                    BackgroundColor="#3A1320"
                    Stroke="#EF4444"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="14">
                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="#FCA5A5"
                        FontSize="13"
                        LineBreakMode="WordWrap" />
                </Border>

                <Border
                    IsVisible="{Binding HasNoOpportunities}"
                    BackgroundColor="#0E1628"
                    Stroke="#26324E"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 26"
                    Padding="22"
                    Margin="0,20,0,0">
                    <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                        <Label
                            Text="No matching opportunities"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="Your selected job does not match any JobOffers templates yet, or the API returned no data."
                            FontSize="13"
                            TextColor="#9AA4B7"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <CollectionView
                    ItemsSource="{Binding Opportunities}"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="model:OpportunityItem">
                            <Border
                                BackgroundColor="#0E1628"
                                Stroke="#24304D"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 30"
                                Padding="18"
                                Margin="0,0,0,16">

                                <Border.Shadow>
                                    <Shadow Brush="#000000" Opacity="0.35" Radius="16" Offset="0,8" />
                                </Border.Shadow>

                                <VerticalStackLayout Spacing="14">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                        <Border
                                            WidthRequest="58"
                                            HeightRequest="58"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 29"
                                            BackgroundColor="#17213A"
                                            VerticalOptions="Start">
                                            <Label
                                                Text="{Binding LogoLetter}"
                                                FontSize="22"
                                                FontAttributes="Bold"
                                                TextColor="White"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="6">
                                                <Label
                                                    Text="{Binding Company}"
                                                    FontSize="14"
                                                    TextColor="#B9C2D5"
                                                    LineBreakMode="TailTruncation" />
                                                <Label Text="·" TextColor="#69748D" />
                                                <Label
                                                    Text="{Binding PostedAgo}"
                                                    FontSize="13"
                                                    TextColor="#8F99AD" />
                                            </HorizontalStackLayout>

                                            <Label
                                                Text="{Binding Title}"
                                                FontSize="18"
                                                FontAttributes="Bold"
                                                TextColor="White"
                                                LineBreakMode="WordWrap" />

                                            <Label
                                                Text="{Binding Location}"
                                                FontSize="14"
                                                TextColor="#9AA4B7" />
                                        </VerticalStackLayout>

                                        <controls:CircularProgressView
                                            Grid.Column="2"
                                            WidthRequest="74"
                                            HeightRequest="74"
                                            Progress="{Binding Score}"
                                            
                                            CenterText="{Binding ScoreText}"
                                            SubText="match"
                                            StrokeSize="6"
                                            ProgressColor="{Binding ScoreMauiColor}"
                                            TrackColor="Green"
                                            FillColor="#10FFFFFF"
                                            TextColor="White"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center" />
                                    </Grid>

                                    <Grid ColumnDefinitions="*,Auto">
                                        <HorizontalStackLayout Spacing="8" Grid.Column="0">
                                            <Border BackgroundColor="#1D2B50" StrokeThickness="0" StrokeShape="RoundRectangle 13" Padding="11,6">
                                                <Label Text="{Binding WorkType}" FontSize="12" FontAttributes="Bold" TextColor="#C7D2FE" />
                                            </Border>
                                            <Border BackgroundColor="#162840" StrokeThickness="0" StrokeShape="RoundRectangle 13" Padding="11,6">
                                                <Label Text="{Binding Level}" FontSize="12" FontAttributes="Bold" TextColor="#BFDBFE" />
                                            </Border>
                                            <Border BackgroundColor="#2A1834" StrokeThickness="0" StrokeShape="RoundRectangle 13" Padding="11,6">
                                                <Label Text="{Binding Salary}" FontSize="12" FontAttributes="Bold" TextColor="#FDA4AF" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding ArrowIcon}"
                                            FontSize="22"
                                            TextColor="#B8C0D4"
                                            VerticalTextAlignment="Center">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleOpportunityCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>

                                    <Border
                                        IsVisible="{Binding IsExpanded}"
                                        BackgroundColor="#111B31"
                                        Stroke="#25314F"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 22"
                                        Padding="14">
                                        <VerticalStackLayout Spacing="12">
                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="ABOUT ROLE" FontSize="11" CharacterSpacing="1.2" TextColor="#7C86A1" />
                                                <Label Text="{Binding AboutRole}" FontSize="13" TextColor="#D5D9E5" LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Spacing="4">
                                                <Label Text="REQUIRED SKILLS" FontSize="11" CharacterSpacing="1.2" TextColor="#7C86A1" />
                                                <Label Text="{Binding Responsibilities}" FontSize="13" TextColor="#D5D9E5" LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>

                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                <Border BackgroundColor="#0D241E" Stroke="#164E3E" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="12">
                                                    <VerticalStackLayout Spacing="4">
                                                        <Label Text="MATCHED" FontSize="10" CharacterSpacing="1" TextColor="#6EE7B7" />
                                                        <Label Text="{Binding MatchedSkills}" FontSize="12" TextColor="#D1FAE5" LineBreakMode="WordWrap" />
                                                    </VerticalStackLayout>
                                                </Border>

                                                <Border Grid.Column="1" BackgroundColor="#291B25" Stroke="#6B283B" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="12">
                                                    <VerticalStackLayout Spacing="4">
                                                        <Label Text="MISSING" FontSize="10" CharacterSpacing="1" TextColor="#FDA4AF" />
                                                        <Label Text="{Binding MissingSkills}" FontSize="12" TextColor="#FFE4E6" LineBreakMode="WordWrap" />
                                                    </VerticalStackLayout>
                                                </Border>
                                            </Grid>

                                            <Border BackgroundColor="#17213A" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="12">
                                                <Label Text="{Binding MatchNote}" FontSize="12" TextColor="#CBD5E1" LineBreakMode="WordWrap" />
                                            </Border>

                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                                <Border HeightRequest="44" Stroke="#334155" StrokeThickness="1" StrokeShape="RoundRectangle 22" Padding="16,0">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleSaveCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="{Binding SaveIcon}" TextColor="{Binding SaveColor}" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                </Border>

                                                <Border Grid.Column="1" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22" Padding="22,0">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={x:Reference Page}, Path=BindingContext.ApplyCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    </Border.GestureRecognizers>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#3545D4" Offset="0" />
                                                            <GradientStop Color="#985CF2" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Label Text="Apply" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
