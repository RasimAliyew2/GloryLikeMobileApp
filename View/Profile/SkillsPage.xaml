<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MetanetA_MobileApp.View.Profile.SkillsPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:view="clr-namespace:MetanetA_MobileApp.View"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#020617">

    <ContentPage.Resources>
        <Style x:Key="SectionTitleStyle" TargetType="Label">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="White" />
        </Style>

        <Style x:Key="MutedTextStyle" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="#AAB3C5" />
        </Style>

        <Style x:Key="CaptionStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CharacterSpacing" Value="1.2" />
            <Setter Property="TextColor" Value="#8B95AA" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#03031A" Offset="0" />
                <GradientStop Color="#081627" Offset="0.55" />
                <GradientStop Color="#061D24" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="18,22,18,28" Spacing="18">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4">
                        <Label
                            Text="Skills"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="White" />

                        <Label
                            Text="Add skills and tie them to work experience."
                            FontSize="14"
                            TextColor="#AAB3C5" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        HeightRequest="42"
                        Padding="14,0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 21"
                        VerticalOptions="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3545D4" Offset="0" />
                                <GradientStop Color="#985CF2" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ShowAddSkillCommand}" />
                        </Border.GestureRecognizers>

                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label
                                Text="+"
                                FontSize="22"
                                TextColor="White"
                                VerticalTextAlignment="Center" />
                            <Label
                                Text="Add"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="White"
                                VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <ActivityIndicator
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Color="#8B5CF6" />

                <Border
                    IsVisible="{Binding HasError}"
                    BackgroundColor="#3A1018"
                    Stroke="#EF4444"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 18"
                    Padding="14">
                    <Label
                        Text="{Binding ErrorMessage}"
                        TextColor="#FCA5A5"
                        FontSize="13" />
                </Border>

                <!-- Add skill form -->
                <Border
                    IsVisible="{Binding IsAddSkillVisible}"
                    Stroke="#4F46E5"
                    StrokeThickness="1.2"
                    StrokeDashArray="4,4"
                    StrokeShape="RoundRectangle 28"
                    BackgroundColor="#111827"
                    Padding="18">

                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="3">
                                <Label
                                    Text="Add a skill"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="White" />
                                <Label
                                    Text="Choose a skill from your job selection data."
                                    FontSize="13"
                                    TextColor="#AAB3C5" />
                            </VerticalStackLayout>

                            <Label
                                Grid.Column="1"
                                Text="×"
                                FontSize="26"
                                TextColor="#AAB3C5">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CancelAddSkillCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <VerticalStackLayout Spacing="8">
                            <Label
                                Text="SKILL"
                                Style="{StaticResource CaptionStyle}" />

                            <Border
                                BackgroundColor="#F8FAFC"
                                Stroke="#334155"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="10,0">
                                <Picker
                                    Title="Choose a skill"
                                    ItemsSource="{Binding AvailableSkills}"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    SelectedItem="{Binding SelectedAvailableSkill}"
                                    TextColor="#111827"
                                    TitleColor="#667085"
                                    FontSize="15"
                                    HeightRequest="48" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10">
                            <Label
                                Text="USED IN"
                                Style="{StaticResource CaptionStyle}" />

                            <FlexLayout
                                BindableLayout.ItemsSource="{Binding CompanyOptions}"
                                Wrap="Wrap"
                                Direction="Row"
                                AlignItems="Start"
                                JustifyContent="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Stroke="#334155"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 18"
                                            BackgroundColor="#182235"
                                            Padding="14,8"
                                            Margin="0,0,8,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleCompanyCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#3344D5" />
                                                    <Setter Property="Stroke" Value="#7C8CFF" />
                                                </DataTrigger>
                                            </Border.Triggers>

                                            <Label
                                                Text="{Binding Name}"
                                                FontSize="13"
                                                TextColor="#DDE3F0" />
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Border
                                Grid.Column="0"
                                HeightRequest="48"
                                Stroke="#334155"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 24"
                                BackgroundColor="#0F172A">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding CancelAddSkillCommand}" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="Cancellation"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="#DDE3F0"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>

                            <Border
                                Grid.Column="1"
                                HeightRequest="48"
                                Padding="20,0"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 24">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#3545D4" Offset="0" />
                                        <GradientStop Color="#985CF2" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AddSelectedSkillCommand}" />
                                </Border.GestureRecognizers>
                                <Label
                                    Text="Add a skill"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    HorizontalTextAlignment="Center"
                                    VerticalTextAlignment="Center" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Added skill cards -->
                <CollectionView
                    ItemsSource="{Binding AddedSkills}"
                    SelectionMode="None"
                    IsVisible="{Binding HasAddedSkills}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Stroke="#26344D"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 24"
                                BackgroundColor="#0F172A"
                                Padding="16"
                                Margin="0,0,0,14">

                                <VerticalStackLayout Spacing="14">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <Border
                                            WidthRequest="46"
                                            HeightRequest="46"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 15"
                                            BackgroundColor="#1D2740">
                                            <Label
                                                Text="✧"
                                                FontSize="22"
                                                TextColor="#C4B5FD"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label
                                                Text="{Binding SkillName}"
                                                FontSize="19"
                                                FontAttributes="Bold"
                                                TextColor="White" />
                                            <Label
                                                Text="{Binding UsedInText}"
                                                FontSize="12"
                                                TextColor="#8B95AA" />
                                        </VerticalStackLayout>

                                        <Label
                                            Grid.Column="2"
                                            Text="×"
                                            FontSize="22"
                                            TextColor="#8B95AA">
                                            <Label.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.RemoveSkillCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Label.GestureRecognizers>
                                        </Label>
                                    </Grid>

                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="88,*,34" RowSpacing="12" ColumnSpacing="10">
                                        <Label Grid.Row="0" Grid.Column="0" Text="Knowledge" FontSize="12" TextColor="#AAB3C5" />
                                        <ProgressBar Grid.Row="0" Grid.Column="1" Progress="{Binding KnowledgeRatio}" ProgressColor="#8B5CF6" BackgroundColor="#27344B" HeightRequest="5" />
                                        <Label Grid.Row="0" Grid.Column="2" Text="{Binding Knowledge}" FontAttributes="Bold" FontSize="12" TextColor="White" HorizontalTextAlignment="End" />

                                        <Label Grid.Row="1" Grid.Column="0" Text="Experience" FontSize="12" TextColor="#AAB3C5" />
                                        <ProgressBar Grid.Row="1" Grid.Column="1" Progress="{Binding ExperienceRatio}" ProgressColor="#8B5CF6" BackgroundColor="#27344B" HeightRequest="5" />
                                        <Label Grid.Row="1" Grid.Column="2" Text="{Binding Experience}" FontAttributes="Bold" FontSize="12" TextColor="White" HorizontalTextAlignment="End" />

                                        <Label Grid.Row="2" Grid.Column="0" Text="Depth" FontSize="12" TextColor="#AAB3C5" />
                                        <ProgressBar Grid.Row="2" Grid.Column="1" Progress="{Binding DepthRatio}" ProgressColor="#8B5CF6" BackgroundColor="#27344B" HeightRequest="5" />
                                        <Label Grid.Row="2" Grid.Column="2" Text="{Binding Depth}" FontAttributes="Bold" FontSize="12" TextColor="White" HorizontalTextAlignment="End" />
                                    </Grid>

                                    <BoxView HeightRequest="1" BackgroundColor="#26344D" />

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <Label Text="CREDIBILITY" FontSize="12" CharacterSpacing="1.1" TextColor="#8B95AA" />
                                            <Label Text="{Binding Credibility}" FontSize="18" FontAttributes="Bold" TextColor="White" />
                                        </HorizontalStackLayout>

                                        <Border
                                            Grid.Column="1"
                                            HeightRequest="36"
                                            Padding="12,0"
                                            Stroke="#334155"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 18"
                                            BackgroundColor="#121B2E">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.AssessDepthCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="7" VerticalOptions="Center">
                                                <Label Text="⚡" FontSize="16" TextColor="White" />
                                                <Label Text="Assess depth" FontSize="13" FontAttributes="Bold" TextColor="White" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Border
                    IsVisible="{Binding HasNoSkills}"
                    Stroke="#26344D"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="#0F172A"
                    Padding="22"
                    HeightRequest="170">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                        <Label
                            Text="No skills added yet"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="Tap Add to create your first skill."
                            FontSize="13"
                            TextColor="#AAB3C5"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- Experience section -->
                <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
                    <Label
                        Text="Experience"
                        Style="{StaticResource SectionTitleStyle}" />
                    <Label
                        Grid.Column="1"
                        Text="+ Add"
                        FontSize="15"
                        TextColor="#8B5CF6"
                        FontAttributes="Bold"
                        VerticalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddExperienceCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Border
                    Stroke="#26344D"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    BackgroundColor="#0F172A"
                    Padding="22"
                    HeightRequest="155">
                    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="10">
                        <Label
                            Text="No experience added yet"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="Tap Add to create your first experience."
                            FontSize="13"
                            TextColor="#AAB3C5"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <view:BottomMenu Grid.Row="1" />
    </Grid>
</ContentPage>
