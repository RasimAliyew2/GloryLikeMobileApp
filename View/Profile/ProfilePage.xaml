<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MetanetA_MobileApp.View.Profile.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controlsBottom="clr-namespace:MetanetA_MobileApp.View"
    BackgroundColor="#F4F7FC"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">
    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,28" Spacing="20">

            <!-- Header -->
            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                <Label
                    Text="Profile"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="#0F172A"
                    VerticalTextAlignment="Center" />

                <Border
                    Grid.Column="1"
                    WidthRequest="42"
                    HeightRequest="42"
                    StrokeThickness="0"
                    BackgroundColor="#EEF2FF"
                    StrokeShape="RoundRectangle 21">
                    <Label
                        Text="🔔"
                        FontSize="18"
                        HorizontalTextAlignment="Center"
                        VerticalTextAlignment="Center" />
                </Border>
            </Grid>

            <!-- Profile card -->
            <Border
                Stroke="#DEE6F2"
                StrokeThickness="1"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 28"
                Padding="20">

                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border
                            WidthRequest="84"
                            HeightRequest="84"
                            Stroke="#3545D4"
                            StrokeThickness="2"
                            BackgroundColor="#F8FAFF"
                            StrokeShape="RoundRectangle 42"
                            VerticalOptions="Start">
                            <Label
                                Text="{Binding Initials}"
                                FontSize="25"
                                FontAttributes="Bold"
                                TextColor="#0F172A"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="7" VerticalOptions="Center">
                            <Label
                                Text="{Binding FullName}"
                                FontSize="21"
                                FontAttributes="Bold"
                                TextColor="#1E293B"
                                LineBreakMode="TailTruncation" />

                            <Label
                                Text="{Binding RoleTitle}"
                                FontSize="15"
                                TextColor="#475569"
                                LineBreakMode="TailTruncation" />

                            <HorizontalStackLayout Spacing="8">
                                <Border
                                    StrokeThickness="0"
                                    BackgroundColor="#EEF2FF"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="10,4">
                                    <Label Text="Open to work" FontSize="13" FontAttributes="Bold" TextColor="#2938B8" />
                                </Border>

                                <Border
                                    StrokeThickness="0"
                                    BackgroundColor="#F1F5F9"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="10,4">
                                    <Label Text="Hybrid" FontSize="13" TextColor="#64748B" />
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4,0,0">
                        <Label
                            Text="{Binding ProfileCompletionText}"
                            FontSize="15"
                            TextColor="#475569" />

                        <Label
                            Grid.Column="1"
                            Text="✎ Edit profile"
                            FontSize="14"
                            TextColor="#0F172A" />
                    </Grid>

                    <ProgressBar
                        Progress="{Binding ProfileCompletionProgress}"
                        ProgressColor="#3545D4"
                        BackgroundColor="#E8EDF5"
                        HeightRequest="7" />
                </VerticalStackLayout>
            </Border>

            <!-- Career readiness -->
            <Border
                Stroke="#DEE6F2"
                StrokeThickness="1"
                BackgroundColor="White"
                StrokeShape="RoundRectangle 28"
                Padding="20">

                <VerticalStackLayout Spacing="16">
                    <Label
                        Text="CAREER READINESS"
                        FontSize="15"
                        CharacterSpacing="1"
                        TextColor="#475569" />

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="0">
                        <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                            <Label Text="{Binding MatchScoreText}" FontSize="26" FontAttributes="Bold" TextColor="#020617" HorizontalTextAlignment="Center" />
                            <Label Text="Match" FontSize="14" TextColor="#475569" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                            <Label Text="{Binding TrustScoreText}" FontSize="26" FontAttributes="Bold" TextColor="#020617" HorizontalTextAlignment="Center" />
                            <Label Text="Trust" FontSize="14" TextColor="#475569" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                            <Label Text="{Binding VerificationLevel}" FontSize="18" FontAttributes="Bold" TextColor="#020617" HorizontalTextAlignment="Center" />
                            <Label Text="Level" FontSize="14" TextColor="#475569" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center">
                            <Label Text="{Binding StrengthScoreText}" FontSize="26" FontAttributes="Bold" TextColor="#020617" HorizontalTextAlignment="Center" />
                            <Label Text="Strength" FontSize="14" TextColor="#475569" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#E2E8F0" />

                    <Label
                        Text="{Binding StrongestRoleText}"
                        FontSize="15"
                        TextColor="#475569"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Skill passport -->
            <VerticalStackLayout Spacing="12">
                <Label
                    Text="Skill Passport"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#020617" />

                <Label
                    Text="No skills added yet. Add and verify skills to build your profile."
                    FontSize="14"
                    TextColor="#64748B"
                    IsVisible="{Binding HasNoSkills}" />

                <CollectionView
                    ItemsSource="{Binding Skills}"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,12"
                                Stroke="#DEE6F2"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                StrokeShape="RoundRectangle 24"
                                Padding="18">

                                <VerticalStackLayout Spacing="13">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding SkillName}" FontSize="18" FontAttributes="Bold" TextColor="#020617" VerticalTextAlignment="Center" />
                                            <Border StrokeThickness="0" BackgroundColor="#F1F5F9" StrokeShape="RoundRectangle 12" Padding="9,3">
                                                <Label Text="{Binding Category}" FontSize="13" TextColor="#64748B" />
                                            </Border>
                                        </HorizontalStackLayout>

                                        <Label
                                            Grid.Column="1"
                                            Text="{Binding ScoreText}"
                                            FontSize="17"
                                            FontAttributes="Bold"
                                            TextColor="#020617"
                                            VerticalTextAlignment="Center" />

                                        <Border
                                            Grid.Column="2"
                                            StrokeThickness="0"
                                            BackgroundColor="#EEF2FF"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="9,4">
                                            <Label Text="{Binding BadgeText}" FontSize="13" TextColor="#2938B8" />
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="9">
                                        <Label Grid.Row="0" Grid.Column="0" Text="Knowledge" FontSize="14" TextColor="#475569" />
                                        <ProgressBar Grid.Row="0" Grid.Column="1" Progress="{Binding KnowledgeProgress}" ProgressColor="#3545D4" BackgroundColor="#E8EDF5" HeightRequest="6" />
                                        <Label Grid.Row="0" Grid.Column="2" Text="{Binding KnowledgeText}" FontSize="14" TextColor="#475569" />

                                        <Label Grid.Row="1" Grid.Column="0" Text="Experience" FontSize="14" TextColor="#475569" />
                                        <ProgressBar Grid.Row="1" Grid.Column="1" Progress="{Binding ExperienceProgress}" ProgressColor="#6475C8" BackgroundColor="#E8EDF5" HeightRequest="6" />
                                        <Label Grid.Row="1" Grid.Column="2" Text="{Binding ExperienceText}" FontSize="14" TextColor="#475569" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- Experience -->
            <VerticalStackLayout Spacing="12">
                <Label
                    Text="Experience"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="#020617" />

                <Label
                    Text="No work experience added yet. Add experience to strengthen your profile."
                    FontSize="14"
                    TextColor="#64748B"
                    IsVisible="{Binding HasNoExperiences}" />

                <CollectionView
                    ItemsSource="{Binding Experiences}"
                    SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Margin="0,0,0,12"
                                Stroke="#DEE6F2"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                StrokeShape="RoundRectangle 24"
                                Padding="18">

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border
                                        WidthRequest="44"
                                        HeightRequest="44"
                                        StrokeThickness="0"
                                        BackgroundColor="#EEF2FF"
                                        StrokeShape="RoundRectangle 22">
                                        <Label Text="💼" FontSize="18" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                                        <Label Text="{Binding CompanyName}" FontSize="18" FontAttributes="Bold" TextColor="#020617" />
                                        <Label Text="{Binding PositionName}" FontSize="15" TextColor="#475569" />
                                        <Label Text="{Binding PeriodText}" FontSize="14" TextColor="#64748B" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>

        <!-- Aşağı hissə: sabit bottom menu -->
        <controlsBottom:BottomMenu Grid.Row="1" />
    </Grid>
</ContentPage>
