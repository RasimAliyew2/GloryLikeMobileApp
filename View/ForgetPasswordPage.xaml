<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MetanetA_MobileApp.View.ForgetPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#070A13">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#050714" Offset="0" />
                <GradientStop Color="#101226" Offset="0.55" />
                <GradientStop Color="#070A13" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="22,42,22,30" Spacing="20">

                <HorizontalStackLayout Spacing="8">
                    <Label Text="‹" FontSize="28" TextColor="White" />
                    <Label Text="Back to sign in" TextColor="#AAB2C5" FontSize="14" VerticalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackToSignInCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Reset password" FontSize="28" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Enter your email, get a reset code, then create a new password." FontSize="15" TextColor="#AAB2C5" />
                </VerticalStackLayout>

                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 30" Padding="20">
                    <VerticalStackLayout Spacing="13">

                        <Border BackgroundColor="#F3F5FA" Stroke="#E1E6F0" StrokeThickness="1" StrokeShape="RoundRectangle 17" Padding="14,0">
                            <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" FontSize="15" TextColor="#111827" PlaceholderColor="#8B95AA" BackgroundColor="Transparent" HeightRequest="50" />
                        </Border>

                        <Border HeightRequest="50" StrokeThickness="0" StrokeShape="RoundRectangle 17">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#3545D4" Offset="0" />
                                    <GradientStop Color="#985CF2" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SendResetCodeCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Send reset code" TextColor="White" FontAttributes="Bold" FontSize="15" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>

                        <Border IsVisible="{Binding HasDevelopmentResetCode}" BackgroundColor="#EEF2FF" Stroke="#3545D4" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="12">
                            <Label Text="{Binding DevelopmentResetCode, StringFormat='Development reset code: {0}'}" TextColor="#3545D4" FontAttributes="Bold" FontSize="13" />
                        </Border>

                        <VerticalStackLayout IsVisible="{Binding IsCodeSent}" Spacing="13">
                            <Border BackgroundColor="#F3F5FA" Stroke="#E1E6F0" StrokeThickness="1" StrokeShape="RoundRectangle 17" Padding="14,0">
                                <Entry Placeholder="Reset code" Text="{Binding ResetCode}" Keyboard="Numeric" FontSize="15" TextColor="#111827" PlaceholderColor="#8B95AA" BackgroundColor="Transparent" HeightRequest="50" />
                            </Border>

                            <Border BackgroundColor="#F3F5FA" Stroke="#E1E6F0" StrokeThickness="1" StrokeShape="RoundRectangle 17" Padding="14,0">
                                <Entry Placeholder="New password" Text="{Binding NewPassword}" IsPassword="True" FontSize="15" TextColor="#111827" PlaceholderColor="#8B95AA" BackgroundColor="Transparent" HeightRequest="50" />
                            </Border>

                            <Border BackgroundColor="#F3F5FA" Stroke="#E1E6F0" StrokeThickness="1" StrokeShape="RoundRectangle 17" Padding="14,0">
                                <Entry Placeholder="Confirm new password" Text="{Binding ConfirmNewPassword}" IsPassword="True" FontSize="15" TextColor="#111827" PlaceholderColor="#8B95AA" BackgroundColor="Transparent" HeightRequest="50" />
                            </Border>

                            <Border HeightRequest="50" StrokeThickness="0" StrokeShape="RoundRectangle 17" BackgroundColor="#151426">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ResetPasswordCommand}" />
                                </Border.GestureRecognizers>
                                <Label Text="Reset password" TextColor="White" FontAttributes="Bold" FontSize="15" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <Label Text="{Binding Message}" IsVisible="{Binding HasMessage}" TextColor="#027A48" FontSize="13" />
                        <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#D92D20" FontSize="13" />
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#3545D4" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
