<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MetanetA_MobileApp.View.SignUp.SkillsSelectionPage"
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#050816">

    <ContentPage.Resources>
        <Style x:Key="SelectionCard" TargetType="Border">
            <Setter Property="Stroke" Value="#E5E7EB" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="StrokeShape" Value="RoundRectangle 18" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Caption" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CharacterSpacing" Value="1.2" />
            <Setter Property="TextColor" Value="#6B7280" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="22">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#050816" Offset="0" />
                <GradientStop Color="#0B1024" Offset="0.55" />
                <GradientStop Color="#111827" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="20" Padding="0,14,0,28">
                <Grid ColumnDefinitions="Auto,*">
                    <Label Text="‹ Back" FontSize="14" TextColor="#D1D5DB">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                    <Label Grid.Column="1" Text="Skip" FontSize="14" TextColor="#D1D5DB" HorizontalOptions="End">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SkipCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border WidthRequest="64" HeightRequest="64" StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="#FFFFFF">
                        <Label Text="S" FontSize="30" FontAttributes="Bold" TextColor="#111827" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <Label Text="Select the skills you can prove" FontSize="30" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    <Label Text="Choose a role path, then select skills for verification." FontSize="15" TextColor="#CBD5E1" HorizontalTextAlignment="Center" MaximumWidthRequest="380" />
                </VerticalStackLayout>

                <Border BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 30" Padding="20" MaximumWidthRequest="460">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Opacity="0.22" Radius="24" Offset="0,12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="6">
                            <BoxView HeightRequest="5" CornerRadius="3" Color="#111827" />
                            <BoxView Grid.Column="1" HeightRequest="5" CornerRadius="3" Color="#111827" />
                            <BoxView Grid.Column="2" HeightRequest="5" CornerRadius="3" Color="#111827" />
                            <BoxView Grid.Column="3" HeightRequest="5" CornerRadius="3" Color="#E5E7EB" />
                            <BoxView Grid.Column="4" HeightRequest="5" CornerRadius="3" Color="#E5E7EB" />
                            <BoxView Grid.Column="5" HeightRequest="5" CornerRadius="3" Color="#E5E7EB" />
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="SKILLS" Style="{StaticResource Caption}" />
                            <Label Text="{Binding SectionTitle}" FontSize="22" FontAttributes="Bold" TextColor="#111827" />
                            <Label Text="{Binding BreadcrumbText}" IsVisible="{Binding ShowBreadcrumb}" FontSize="13" TextColor="#6B7280" />
                        </VerticalStackLayout>

                        <ActivityIndicator IsVisible="{Binding IsBusy}" IsRunning="{Binding IsBusy}" Color="#111827" />
                        <Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" FontSize="13" TextColor="#B91C1C" />

                        <CollectionView ItemsSource="{Binding JobFamilyOptions}" IsVisible="{Binding IsJobFamilyStep}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SelectionCard}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.SelectJobFamilyCommand, Source={x:Reference RootPage}}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Title}" FontSize="16" TextColor="#111827" VerticalTextAlignment="Center" />
                                            <Label Grid.Column="1" Text="›" FontSize="22" TextColor="#9CA3AF" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <CollectionView ItemsSource="{Binding SeniorityOptions}" IsVisible="{Binding IsSeniorityStep}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SelectionCard}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.SelectSeniorityCommand, Source={x:Reference RootPage}}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Title}" FontSize="16" TextColor="#111827" VerticalTextAlignment="Center" />
                                            <Label Grid.Column="1" Text="›" FontSize="22" TextColor="#9CA3AF" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <CollectionView ItemsSource="{Binding PositionOptions}" IsVisible="{Binding IsPositionStep}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource SelectionCard}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding BindingContext.SelectPositionCommand, Source={x:Reference RootPage}}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Text="{Binding Title}" FontSize="16" TextColor="#111827" VerticalTextAlignment="Center" />
                                            <Label Grid.Column="1" Text="›" FontSize="22" TextColor="#9CA3AF" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <VerticalStackLayout IsVisible="{Binding IsSkillStep}" Spacing="14">
                            <FlexLayout BindableLayout.ItemsSource="{Binding SkillOptions}" Wrap="Wrap" Direction="Row" AlignItems="Start">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border BackgroundColor="#F3F4F6" Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 18" Padding="12,10" Margin="0,0,8,8">
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="#111827" />
                                                    <Setter Property="Stroke" Value="#111827" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding BindingContext.ToggleSkillCommand, Source={x:Reference RootPage}}" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <HorizontalStackLayout Spacing="8">
                                                <Label Text="✓" IsVisible="{Binding IsSelected}" FontAttributes="Bold" TextColor="#FFFFFF" />
                                                <Label Text="{Binding Skill.SkillName}" FontSize="14" TextColor="#111827">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="TextColor" Value="#FFFFFF" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>

                            <Button Text="{Binding SelectedSkillCount, StringFormat='Verify selected skills ({0})'}" IsVisible="{Binding HasSelectedSkills}" HeightRequest="56" CornerRadius="18" BackgroundColor="#111827" TextColor="#FFFFFF" FontAttributes="Bold" Command="{Binding ContinueCommand}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
