<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MetanetA_MobileApp.View.SignUp.ProfileReviewPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MetanetA_MobileApp.ViewModels.Sign.SingUp"
    BackgroundColor="#050816"
    Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <Style x:Key="StepTextStyle" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="#B8C0D9" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#050816" Offset="0" />
                    <GradientStop Color="#0D1326" Offset="0.55" />
                    <GradientStop Color="#10233F" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView>
            <VerticalStackLayout Padding="20,34,20,28" Spacing="18">

                <Grid HorizontalOptions="Center" WidthRequest="330" HeightRequest="66">
                    <Grid ColumnDefinitions="*,*,*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Center">
                            <Border WidthRequest="24" HeightRequest="24" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#4659C8">
                                <Label Text="✓" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Text="Identity" Style="{StaticResource StepTextStyle}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="Center">
                            <Border WidthRequest="24" HeightRequest="24" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#4659C8">
                                <Label Text="✓" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Text="Career" Style="{StaticResource StepTextStyle}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="Center">
                            <Border WidthRequest="24" HeightRequest="24" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#4659C8">
                                <Label Text="✓" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Text="Skills" Style="{StaticResource StepTextStyle}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="3" Spacing="4" HorizontalOptions="Center">
                            <Border WidthRequest="24" HeightRequest="24" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#4659C8">
                                <Label Text="✓" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Text="Verify" Style="{StaticResource StepTextStyle}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="4" Spacing="4" HorizontalOptions="Center">
                            <Border WidthRequest="24" HeightRequest="24" StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#4659C8">
                                <Label Text="✓" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Text="Prefs" Style="{StaticResource StepTextStyle}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="5" Spacing="4" HorizontalOptions="Center">
                            <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="#3447B7">
                                <Label Text="●" FontSize="11" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Text="Ready&#10;1 min" FontSize="11" TextColor="White" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView VerticalOptions="End" HeightRequest="4" Margin="4,0,4,0" BackgroundColor="#1F2940" />
                    <BoxView VerticalOptions="End" HorizontalOptions="Start" WidthRequest="315" HeightRequest="4" Margin="4,0,0,0" BackgroundColor="#4659C8" />
                </Grid>

                <Border
                    Stroke="#1D2740"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 34"
                    BackgroundColor="#F8FAFD"
                    Padding="18,18,18,24"
                    WidthRequest="330"
                    HorizontalOptions="Center">

                    <VerticalStackLayout Spacing="18">

                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="7">
                                <HorizontalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                                </HorizontalStackLayout.GestureRecognizers>
                                <Label Text="‹" FontSize="24" TextColor="#475166" VerticalTextAlignment="Center" />
                                <Label Text="Back" FontSize="14" TextColor="#475166" VerticalTextAlignment="Center" />
                            </HorizontalStackLayout>

                            <Label Grid.Column="1" Text="Skip for now" FontSize="14" TextColor="#3447B7" TextDecorations="Underline">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SkipCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Your profile review" FontSize="23" FontAttributes="Bold" TextColor="#030712" />
                            <Label Text="Here's what our AI found." FontSize="16" TextColor="#4B5563" />
                        </VerticalStackLayout>

                        <Border Stroke="#DFE5EF" StrokeThickness="1" StrokeShape="RoundRectangle 26" BackgroundColor="White" Padding="16">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="18">
                                <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                    <Border WidthRequest="88" HeightRequest="88" Stroke="#EEF2F8" StrokeThickness="8" StrokeShape="RoundRectangle 44" BackgroundColor="White">
                                        <Label Text="{Binding ProfileStrength}" FontSize="28" FontAttributes="Bold" TextColor="#030712" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label Text="match" FontSize="12" TextColor="#344054" HorizontalTextAlignment="Center" Margin="0,-34,0,0" />
                                    <Label Text="Profile strength" FontSize="14" TextColor="#344054" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="Center">
                                    <Border WidthRequest="88" HeightRequest="88" Stroke="#EEF2F8" StrokeThickness="8" StrokeShape="RoundRectangle 44" BackgroundColor="White">
                                        <Label Text="{Binding HiringReadiness}" FontSize="28" FontAttributes="Bold" TextColor="#030712" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    </Border>
                                    <Label Text="match" FontSize="12" TextColor="#344054" HorizontalTextAlignment="Center" Margin="0,-34,0,0" />
                                    <Label Text="Hiring readiness" FontSize="14" TextColor="#344054" HorizontalTextAlignment="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Insights}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProfileReviewInsightItem">
                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="#EEF2F8" Padding="16">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Label Text="✣" FontSize="22" TextColor="#3447B7" VerticalOptions="Start" />
                                            <Label Grid.Column="1" Text="{Binding Text}" FontSize="16" TextColor="#030712" LineBreakMode="WordWrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Border HeightRequest="54" StrokeThickness="0" StrokeShape="RoundRectangle 28" BackgroundColor="#3447B7" Margin="0,4,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding FinishCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Finish setup" FontSize="16" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
