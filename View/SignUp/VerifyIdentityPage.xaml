<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MetanetA_MobileApp.View.SignUp.VerifyIdentityPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#050816">

    <ContentPage.Resources>
        <Style x:Key="MutedLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#9CA3AF" />
            <Setter Property="FontSize" Value="14" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="22">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#050816" Offset="0" />
                <GradientStop Color="#0B1024" Offset="0.55" />
                <GradientStop Color="#111827" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="20" Padding="0,14,0,28">
                <Grid ColumnDefinitions="Auto,*">
                    <Label
                        Text="‹ Back"
                        FontSize="14"
                        TextColor="#D1D5DB">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label
                        Grid.Column="1"
                        Text="Skip for now"
                        FontSize="14"
                        TextColor="#D1D5DB"
                        HorizontalOptions="End">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SkipForNowCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border WidthRequest="64" HeightRequest="64" StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="#FFFFFF">
                        <Label Text="S" FontSize="30" FontAttributes="Bold" TextColor="#111827" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                    <Label Text="Verify your identity" FontSize="30" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalTextAlignment="Center" />
                    <Label Text="This keeps your skill profile trustworthy for employers." Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" MaximumWidthRequest="360" />
                </VerticalStackLayout>

                <Border BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 30" Padding="20" MaximumWidthRequest="440">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Opacity="0.22" Radius="24" Offset="0,12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="18">
                        <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="6">
                            <BoxView HeightRequest="5" CornerRadius="3" Color="#111827" />
                            <BoxView Grid.Column="1" HeightRequest="5" CornerRadius="3" Color="#E5E7EB" />
                            <BoxView Grid.Column="2" HeightRequest="5" CornerRadius="3" Color="#E5E7EB" />
                            <BoxView Grid.Column="3" HeightRequest="5" CornerRadius="3" Color="#E5E7EB" />
                            <BoxView Grid.Column="4" HeightRequest="5" CornerRadius="3" Color="#E5E7EB" />
                            <BoxView Grid.Column="5" HeightRequest="5" CornerRadius="3" Color="#E5E7EB" />
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="IDENTITY" FontSize="12" CharacterSpacing="1.2" TextColor="#6B7280" />
                            <Label Text="Confirm who you are" FontSize="22" FontAttributes="Bold" TextColor="#111827" />
                            <Label Text="Choose a verification method. You can skip this step during testing." FontSize="14" TextColor="#6B7280" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Border Stroke="#E5E7EB" BackgroundColor="#F9FAFB" StrokeShape="RoundRectangle 22" Padding="16">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 14" BackgroundColor="#111827">
                                    <Label Text="ID" TextColor="White" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="SİMA / digital identity" FontSize="16" FontAttributes="Bold" TextColor="#111827" />
                                    <Label Text="Fast identity verification for candidates." FontSize="13" TextColor="#6B7280" />
                                </VerticalStackLayout>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding VerifyWithSimaCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Button Text="Continue with identity verification" HeightRequest="56" CornerRadius="18" BackgroundColor="#111827" TextColor="#FFFFFF" FontAttributes="Bold" Command="{Binding VerifyWithSimaCommand}" />
                        <Button Text="Skip this step" HeightRequest="52" CornerRadius="18" BackgroundColor="#F3F4F6" TextColor="#111827" FontAttributes="Bold" Command="{Binding SkipForNowCommand}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
