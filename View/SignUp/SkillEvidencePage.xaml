<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MetanetA_MobileApp.View.SignUp.SkillEvidencePage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MetanetA_MobileApp.ViewModels.Sign.SingUp"
    BackgroundColor="#F4F6FB">

    <ContentPage.Resources>
        <Style x:Key="StepTextStyle" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="#475467" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>

        <Style x:Key="InputStyle" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="TextColor" Value="#101828" />
            <Setter Property="PlaceholderColor" Value="#7A8496" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20,18,20,30" Spacing="18">

            <Grid ColumnDefinitions="*,Auto">
                <HorizontalStackLayout Spacing="8">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>
                    <Label Text="‹" FontSize="23" TextColor="#475467" />
                    <Label Text="Back" FontSize="14" TextColor="#475467" VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <Label
                    Grid.Column="1"
                    Text="Skip for now"
                    FontSize="14"
                    TextColor="#344054"
                    TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SkipForNowCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <Border
                Stroke="#D9E0EC"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 28"
                BackgroundColor="#FFFFFF"
                Padding="16">

                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="4">
                        <VerticalStackLayout Spacing="4">
                            <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="#3344BB">
                                <Label Text="✓" FontSize="12" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Text="Identity" Style="{StaticResource StepTextStyle}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="#3344BB">
                                <Label Text="✓" FontSize="12" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Text="Career" Style="{StaticResource StepTextStyle}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="4">
                            <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="#3344BB">
                                <Label Text="✓" FontSize="12" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Text="Skills" Style="{StaticResource StepTextStyle}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="3" Spacing="4">
                            <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="#3344BB">
                                <Label Text="✓" FontSize="12" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Text="Verify" FontSize="11" FontAttributes="Bold" TextColor="#101828" HorizontalTextAlignment="Center" />
                            <Label Text="4 min" FontSize="10" TextColor="#667085" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="4" Spacing="4">
                            <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="#D0D5DD" />
                            <Label Text="Prefs" Style="{StaticResource StepTextStyle}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="5" Spacing="4">
                            <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="#D0D5DD" />
                            <Label Text="Ready" Style="{StaticResource StepTextStyle}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="4" CornerRadius="2" BackgroundColor="#EEF2F6" />

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Verify your skills" FontSize="23" FontAttributes="Bold" TextColor="#101828" />
                        <Label Text="Add a certificate or employer history to boost credibility." FontSize="15" TextColor="#667085" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>

                    <Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" FontSize="14" TextColor="#D92D20" />

                    <CollectionView ItemsSource="{Binding Skills}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SkillEvidenceItem">
                                <Border Stroke="#D9E0EC" StrokeThickness="1" StrokeShape="RoundRectangle 22" BackgroundColor="#FFFFFF" Margin="0,0,0,14">
                                    <VerticalStackLayout Spacing="0">
                                        <Grid Padding="14" ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Spacing="2">
                                                <Label Text="{Binding SkillName}" FontSize="18" FontAttributes="Bold" TextColor="#101828" />
                                                <Label Text="{Binding CredibilityText}" FontSize="13" TextColor="#667085" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1" Text="⌃" FontSize="18" TextColor="#101828" VerticalTextAlignment="Center" />
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleSkillCommand}" CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                        </Grid>

                                        <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="14" Padding="14,0,14,14">
                                            <BoxView HeightRequest="1" BackgroundColor="#EEF2F6" />

                                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="#F8FAFC" Padding="16">
                                                <VerticalStackLayout Spacing="12">
                                                    <Label Text="CERTIFICATE" FontSize="12" CharacterSpacing="1" TextColor="#667085" />

                                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="#FFFFFF" Padding="14,0">
                                                        <Entry Text="{Binding CertificateName}" Placeholder="Certificate name" Style="{StaticResource InputStyle}" />
                                                    </Border>

                                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="#FFFFFF" Padding="14,0">
                                                        <Entry Text="{Binding Issuer}" Placeholder="Issuer (e.g. Google, Coursera)" Style="{StaticResource InputStyle}" />
                                                    </Border>

                                                    <Border HeightRequest="42" Stroke="#98A2FF" StrokeThickness="1" StrokeShape="RoundRectangle 21" BackgroundColor="#F8FAFF">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.AttachCertificateCommand}" CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                        <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                                                            <Label Text="↗" FontSize="16" TextColor="#3344BB" />
                                                            <Label Text="Attach certificate file" FontSize="14" TextColor="#3344BB" VerticalTextAlignment="Center" />
                                                        </HorizontalStackLayout>
                                                    </Border>

                                                    <Label IsVisible="{Binding HasAttachedCertificate}" Text="{Binding AttachedCertificateFileName}" FontSize="12" TextColor="#667085" LineBreakMode="TailTruncation" />

                                                    <Border HeightRequest="46" StrokeThickness="0" StrokeShape="RoundRectangle 23" BackgroundColor="#9EA8DF">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.SubmitCertificateCommand}" CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                        <Label Text="Submit certificate" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                    </Border>
                                                </VerticalStackLayout>
                                            </Border>

                                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 22" BackgroundColor="#F8FAFC" Padding="16">
                                                <VerticalStackLayout Spacing="12">
                                                    <Label Text="EMPLOYER HISTORY" FontSize="12" CharacterSpacing="1" TextColor="#667085" />

                                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="#FFFFFF" Padding="14,0">
                                                        <Entry Text="{Binding CompanyName}" Placeholder="Company name" Style="{StaticResource InputStyle}" />
                                                    </Border>

                                                    <FlexLayout BindableLayout.ItemsSource="{Binding CompanyTypes}" Direction="Row" Wrap="Wrap" AlignItems="Start">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ChoiceChipItem">
                                                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 15" BackgroundColor="#FFFFFF" Padding="12,7" Margin="0,0,8,8">
                                                                    <Border.Triggers>
                                                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="BackgroundColor" Value="#EEF2FF" />
                                                                            <Setter Property="Stroke" Value="#3344BB" />
                                                                            <Setter Property="StrokeThickness" Value="1" />
                                                                        </DataTrigger>
                                                                    </Border.Triggers>
                                                                    <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectCompanyTypeCommand}" CommandParameter="{Binding .}" />
                                                                    </Border.GestureRecognizers>
                                                                    <Label Text="{Binding Text}" FontSize="13" TextColor="#344054" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </FlexLayout>

                                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="#FFFFFF" Padding="12,0">
                                                        <Picker ItemsSource="{Binding Industries}" SelectedItem="{Binding SelectedIndustry}" TextColor="#101828" TitleColor="#667085" HeightRequest="48" />
                                                    </Border>

                                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" BackgroundColor="#FFFFFF" Padding="14,0">
                                                        <Entry Text="{Binding Role}" Placeholder="Your role" Style="{StaticResource InputStyle}" />
                                                    </Border>

                                                    <FlexLayout BindableLayout.ItemsSource="{Binding Durations}" Direction="Row" Wrap="Wrap" AlignItems="Start">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ChoiceChipItem">
                                                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 15" BackgroundColor="#FFFFFF" Padding="12,7" Margin="0,0,8,8">
                                                                    <Border.Triggers>
                                                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="BackgroundColor" Value="#EEF2FF" />
                                                                            <Setter Property="Stroke" Value="#3344BB" />
                                                                            <Setter Property="StrokeThickness" Value="1" />
                                                                        </DataTrigger>
                                                                    </Border.Triggers>
                                                                    <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectDurationCommand}" CommandParameter="{Binding .}" />
                                                                    </Border.GestureRecognizers>
                                                                    <Label Text="{Binding Text}" FontSize="13" TextColor="#344054" />
                                                                </Border>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </FlexLayout>

                                                    <Border HeightRequest="46" StrokeThickness="0" StrokeShape="RoundRectangle 23" BackgroundColor="#161426">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.SubmitEmployerHistoryCommand}" CommandParameter="{Binding .}" />
                                                        </Border.GestureRecognizers>
                                                        <Label Text="Submit employer history" FontSize="14" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                    </Border>
                                                </VerticalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Border HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 26" BackgroundColor="#161426" Margin="0,4,0,0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ContinueCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="Continue" FontSize="15" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
