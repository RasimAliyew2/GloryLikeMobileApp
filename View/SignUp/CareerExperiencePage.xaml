<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MetanetA_MobileApp.View.SignUp.CareerExperiencePage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#050816">

    <ContentPage.Resources>
        <Style x:Key="MutedLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#9CA3AF" />
            <Setter Property="FontSize" Value="14" />
        </Style>

        <Style x:Key="Caption" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CharacterSpacing" Value="1.2" />
            <Setter Property="TextColor" Value="#6B7280" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="22">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#050816" Offset="0" />
                <GradientStop Color="#0B1024" Offset="0.55" />
                <GradientStop Color="#111827" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout Spacing="20" Padding="0,14,0,28">

                <Grid ColumnDefinitions="Auto,*">
                    <Label
                        Text="‹ Back"
                        FontSize="14"
                        TextColor="#D1D5DB">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label
                        Grid.Column="1"
                        Text="Skip for now"
                        FontSize="14"
                        TextColor="#D1D5DB"
                        HorizontalOptions="End">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SkipForNowCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border
                        WidthRequest="64"
                        HeightRequest="64"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#FFFFFF">
                        <Label
                            Text="S"
                            FontSize="30"
                            FontAttributes="Bold"
                            TextColor="#111827"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>

                    <Label
                        Text="Import your work experience"
                        FontSize="30"
                        FontAttributes="Bold"
                        TextColor="#FFFFFF"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />

                    <Label
                        Text="We'll pull your verified employment from ƏMAS."
                        Style="{StaticResource MutedLabel}"
                        HorizontalTextAlignment="Center"
                        MaximumWidthRequest="360" />
                </VerticalStackLayout>

                <Border
                    BackgroundColor="#FFFFFF"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 30"
                    Padding="20"
                    MaximumWidthRequest="440">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Opacity="0.22" Radius="24" Offset="0,12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="20">

                        <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="6">
                            <BoxView HeightRequest="5" CornerRadius="3" Color="#111827" />
                            <BoxView Grid.Column="1" HeightRequest="5" CornerRadius="3" Color="#111827" />
                            <BoxView Grid.Column="2" HeightRequest="5" CornerRadius="3" Color="#E5E7EB" />
                            <BoxView Grid.Column="3" HeightRequest="5" CornerRadius="3" Color="#E5E7EB" />
                            <BoxView Grid.Column="4" HeightRequest="5" CornerRadius="3" Color="#E5E7EB" />
                            <BoxView Grid.Column="5" HeightRequest="5" CornerRadius="3" Color="#E5E7EB" />
                        </Grid>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="CAREER" Style="{StaticResource Caption}" />
                            <Label
                                Text="Import your work experience"
                                FontSize="22"
                                FontAttributes="Bold"
                                TextColor="#111827" />
                            <Label
                                Text="Use ƏMAS or upload a file so we can prepare your skill verification flow."
                                FontSize="14"
                                TextColor="#6B7280"
                                LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <Border
                            HeightRequest="58"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="#3744B6">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ImportFromEmasCommand}" />
                            </Border.GestureRecognizers>

                            <Grid
                                ColumnDefinitions="Auto,Auto"
                                ColumnSpacing="12"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">

                                <Label
                                    Text="⇧"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    VerticalTextAlignment="Center" />

                                <Label
                                    Grid.Column="1"
                                    Text="Import from ƏMAS"
                                    FontSize="18"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    VerticalTextAlignment="Center" />
                            </Grid>
                        </Border>

                        <Label
                            Text="or upload a file (PDF / XML / JSON)"
                            FontSize="15"
                            TextColor="#475467"
                            TextDecorations="Underline"
                            HorizontalTextAlignment="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding UploadFileCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <Border
                            IsVisible="{Binding HasStatusMessage}"
                            Stroke="#D0D5DD"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="#F9FAFB"
                            Padding="16">
                            <Label
                                Text="{Binding StatusMessage}"
                                FontSize="14"
                                TextColor="#344054"
                                LineBreakMode="WordWrap" />
                        </Border>

                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="#111827" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
