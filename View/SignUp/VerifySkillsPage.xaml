<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MetanetA_MobileApp.View.SignUp.VerifySkillsPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MetanetA_MobileApp.ViewModels.Sign.SingUp"
    BackgroundColor="#F4F6FB">

    <ContentPage.Resources>
        <Style x:Key="StepTextStyle" TargetType="Label">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextColor" Value="#475467" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>

        <Style x:Key="QuestionCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="Stroke" Value="#EAECF0" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 20" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="OptionCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#F8FAFC" />
            <Setter Property="Stroke" Value="#E4E7EC" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 14" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,18,20,28" Spacing="18">

                <Grid ColumnDefinitions="*,Auto">
                    <HorizontalStackLayout Spacing="8">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding BackCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Label Text="‹" FontSize="23" TextColor="#475467" />
                        <Label Text="Back" FontSize="14" TextColor="#475467" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>

                    <Label
                        Grid.Column="1"
                        Text="Skip for now"
                        FontSize="14"
                        TextColor="#344054"
                        TextDecorations="Underline">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SkipForNowCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <Border
                    Stroke="#D9E0EC"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 28"
                    BackgroundColor="#FFFFFF"
                    Padding="16">
                    <VerticalStackLayout Spacing="14">

                        <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="4">
                            <VerticalStackLayout Spacing="4">
                                <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="#3344BB">
                                    <Label Text="✓" FontSize="12" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <Label Text="Identity" Style="{StaticResource StepTextStyle}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="#3344BB">
                                    <Label Text="✓" FontSize="12" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <Label Text="Career" Style="{StaticResource StepTextStyle}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="4">
                                <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="#3344BB">
                                    <Label Text="✓" FontSize="12" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <Label Text="Skills" Style="{StaticResource StepTextStyle}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" Spacing="4">
                                <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="#3344BB">
                                    <Label Text="4" FontSize="12" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                </Border>
                                <Label Text="Verify" FontSize="11" FontAttributes="Bold" TextColor="#101828" HorizontalTextAlignment="Center" />
                                <Label Text="4 min" FontSize="10" TextColor="#667085" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="4" Spacing="4">
                                <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="#D0D5DD" />
                                <Label Text="Prefs" Style="{StaticResource StepTextStyle}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="5" Spacing="4">
                                <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0" StrokeShape="RoundRectangle 11" BackgroundColor="#D0D5DD" />
                                <Label Text="Ready" Style="{StaticResource StepTextStyle}" />
                            </VerticalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="4" CornerRadius="2" BackgroundColor="#EEF2F6" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Verify your skills" FontSize="23" FontAttributes="Bold" TextColor="#101828" />
                            <Label Text="Answer the questions for the skills you selected. These questions are generated by the API." FontSize="15" TextColor="#667085" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>

                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#3344BB" />

                        <Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" FontSize="14" TextColor="#D92D20" />

                        <CollectionView ItemsSource="{Binding Skills}" SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="vm:SkillQuestionnaireSessionItem">
                                    <Border
                                        Stroke="#D9E0EC"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 22"
                                        BackgroundColor="#FFFFFF"
                                        Margin="0,0,0,14">
                                        <VerticalStackLayout Spacing="0">
                                            <Grid Padding="14" ColumnDefinitions="*,Auto">
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="{Binding SkillName}" FontSize="18" FontAttributes="Bold" TextColor="#101828" />
                                                    <Label Text="{Binding ProgressText}" FontSize="13" TextColor="#667085" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1" Text="✓" IsVisible="{Binding IsCompleted}" FontSize="17" FontAttributes="Bold" TextColor="#12B76A" VerticalTextAlignment="Center" />
                                            </Grid>

                                            <BoxView HeightRequest="1" BackgroundColor="#EEF2F6" />

                                            <ActivityIndicator Margin="0,16" IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}" Color="#3344BB" />
                                            <Label IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" Margin="14" TextColor="#D92D20" FontSize="13" />

                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding VisibleQuestions}" Padding="14" Spacing="12">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:QuestionnaireQuestionItem">
                                                        <Border Style="{StaticResource QuestionCardStyle}">
                                                            <VerticalStackLayout Spacing="12">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <Label Text="{Binding DimensionCaption}" FontSize="12" CharacterSpacing="1" TextColor="#667085" />
                                                                    <Label Grid.Column="1" Text="Answered" IsVisible="{Binding IsAnswered}" FontSize="12" TextColor="#12B76A" />
                                                                </Grid>

                                                                <Label Text="{Binding Text}" FontSize="15" FontAttributes="Bold" TextColor="#101828" LineBreakMode="WordWrap" />

                                                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Options}" Spacing="0">
                                                                    <BindableLayout.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:QuestionnaireOptionItem">
                                                                            <Border Style="{StaticResource OptionCardStyle}">
                                                                                <Border.Triggers>
                                                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                                                        <Setter Property="BackgroundColor" Value="#EEF2FF" />
                                                                                        <Setter Property="Stroke" Value="#3344BB" />
                                                                                        <Setter Property="StrokeThickness" Value="1.5" />
                                                                                    </DataTrigger>
                                                                                </Border.Triggers>
                                                                                <Border.GestureRecognizers>
                                                                                    <TapGestureRecognizer Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectOptionCommand}" CommandParameter="{Binding .}" />
                                                                                </Border.GestureRecognizers>
                                                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                                    <Border WidthRequest="22" HeightRequest="22" Stroke="#98A2B3" StrokeThickness="1.5" StrokeShape="RoundRectangle 11" BackgroundColor="Transparent" VerticalOptions="Start">
                                                                                        <Label Text="✓" IsVisible="{Binding IsSelected}" FontSize="12" FontAttributes="Bold" TextColor="#3344BB" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                                                                    </Border>
                                                                                    <Label Grid.Column="1" Text="{Binding Label}" FontSize="13" TextColor="#344054" LineBreakMode="WordWrap" />
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </BindableLayout.ItemTemplate>
                                                                </VerticalStackLayout>
                                                            </VerticalStackLayout>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Border HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 26" BackgroundColor="#161426" Margin="0,4,0,0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ContinueCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="{Binding ContinueButtonText}" FontSize="15" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
