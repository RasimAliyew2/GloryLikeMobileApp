<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="MetanetA_MobileApp.View.SignUp.VerifySkillsPage"
    x:Name="Page"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MetanetA_MobileApp.ViewModels.Sign.SingUp"
    BackgroundColor="#F3F5FA">

    <ContentPage.Resources>
        <Style x:Key="CaptionStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CharacterSpacing" Value="1.1" />
            <Setter Property="TextColor" Value="#667085" />
        </Style>

        <Style x:Key="QuestionTextStyle" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#101828" />
            <Setter Property="LineBreakMode" Value="WordWrap" />
        </Style>

        <Style x:Key="OptionCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="White" />
            <Setter Property="Stroke" Value="#D9DFEA" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,18,16,28" Spacing="16">

            <Grid ColumnDefinitions="*,Auto">
                <HorizontalStackLayout Spacing="8">
                    <HorizontalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" />
                    </HorizontalStackLayout.GestureRecognizers>

                    <Label
                        Text="‹"
                        FontSize="26"
                        TextColor="#475166" />

                    <Label
                        Text="Back"
                        FontSize="14"
                        TextColor="#475166"
                        VerticalTextAlignment="Center" />
                </HorizontalStackLayout>

                <Label
                    Grid.Column="1"
                    Text="Skip for now"
                    FontSize="14"
                    TextColor="#475166"
                    TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SkipForNowCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <Border
                BackgroundColor="White"
                Stroke="#E7ECF3"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 30"
                Padding="18">

                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="Verify your skills"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="#071331" />

                        <Label
                            Text="Answer the questions generated for the skills you selected."
                            FontSize="15"
                            TextColor="#475166" />
                    </VerticalStackLayout>

                    <ActivityIndicator
                        IsRunning="{Binding IsBusy}"
                        IsVisible="{Binding IsBusy}"
                        Color="#4453C7" />

                    <Label
                        IsVisible="{Binding HasError}"
                        Text="{Binding ErrorMessage}"
                        FontSize="14"
                        TextColor="#D92D20" />

                    <CollectionView
                        ItemsSource="{Binding Skills}"
                        SelectionMode="None">

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SkillQuestionnaireSessionItem">

                                <Border
                                    Stroke="#DCE2EC"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 24"
                                    BackgroundColor="White"
                                    Margin="0,0,0,16">

                                    <VerticalStackLayout Spacing="0">

                                        <Grid Padding="16,14" ColumnDefinitions="*,Auto">
                                            <VerticalStackLayout Spacing="2">
                                                <Label
                                                    Text="{Binding SkillName}"
                                                    FontSize="18"
                                                    FontAttributes="Bold"
                                                    TextColor="#071331" />

                                                <Label
                                                    Text="{Binding ProgressText}"
                                                    FontSize="14"
                                                    TextColor="#475166" />
                                            </VerticalStackLayout>

                                            <Label
                                                Grid.Column="1"
                                                Text="✓"
                                                IsVisible="{Binding IsCompleted}"
                                                FontSize="18"
                                                FontAttributes="Bold"
                                                TextColor="#12B76A"
                                                VerticalTextAlignment="Center" />
                                        </Grid>

                                        <BoxView
                                            HeightRequest="1"
                                            BackgroundColor="#EEF2F8" />

                                        <ActivityIndicator
                                            Margin="0,16"
                                            IsRunning="{Binding IsLoading}"
                                            IsVisible="{Binding IsLoading}"
                                            Color="#4453C7" />

                                        <Label
                                            IsVisible="{Binding HasError}"
                                            Text="{Binding ErrorMessage}"
                                            Margin="16"
                                            TextColor="#D92D20"
                                            FontSize="13" />

                                        <VerticalStackLayout
                                            BindableLayout.ItemsSource="{Binding VisibleQuestions}"
                                            Padding="14"
                                            Spacing="14">

                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:QuestionnaireQuestionItem">

                                                    <Border
                                                        BackgroundColor="#F8FAFD"
                                                        StrokeThickness="0"
                                                        StrokeShape="RoundRectangle 22"
                                                        Padding="16">

                                                        <VerticalStackLayout Spacing="12">

                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <Label
                                                                    Text="{Binding DimensionCaption}"
                                                                    Style="{StaticResource CaptionStyle}" />

                                                                <Label
                                                                    Grid.Column="1"
                                                                    Text="Answered"
                                                                    IsVisible="{Binding IsAnswered}"
                                                                    FontSize="12"
                                                                    TextColor="#12B76A" />
                                                            </Grid>

                                                            <Label
                                                                Text="{Binding Text}"
                                                                Style="{StaticResource QuestionTextStyle}" />

                                                            <VerticalStackLayout
                                                                BindableLayout.ItemsSource="{Binding Options}"
                                                                Spacing="0">

                                                                <BindableLayout.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:QuestionnaireOptionItem">

                                                                        <Border Style="{StaticResource OptionCardStyle}">
                                                                            <Border.Triggers>
                                                                                <DataTrigger
                                                                                    TargetType="Border"
                                                                                    Binding="{Binding IsSelected}"
                                                                                    Value="True">
                                                                                    <Setter Property="BackgroundColor" Value="#EEF2FF" />
                                                                                    <Setter Property="Stroke" Value="#4453C7" />
                                                                                    <Setter Property="StrokeThickness" Value="1.5" />
                                                                                </DataTrigger>
                                                                            </Border.Triggers>

                                                                            <Border.GestureRecognizers>
                                                                                <TapGestureRecognizer
                                                                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectOptionCommand}"
                                                                                    CommandParameter="{Binding .}" />
                                                                            </Border.GestureRecognizers>

                                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                                <Border
                                                                                    WidthRequest="22"
                                                                                    HeightRequest="22"
                                                                                    Stroke="#4453C7"
                                                                                    StrokeThickness="1.5"
                                                                                    StrokeShape="RoundRectangle 11"
                                                                                    BackgroundColor="Transparent"
                                                                                    VerticalOptions="Start">

                                                                                    <Label
                                                                                        Text="✓"
                                                                                        IsVisible="{Binding IsSelected}"
                                                                                        FontSize="13"
                                                                                        FontAttributes="Bold"
                                                                                        TextColor="#4453C7"
                                                                                        HorizontalTextAlignment="Center"
                                                                                        VerticalTextAlignment="Center" />
                                                                                </Border>

                                                                                <Label
                                                                                    Grid.Column="1"
                                                                                    Text="{Binding Label}"
                                                                                    FontSize="14"
                                                                                    TextColor="#101828"
                                                                                    LineBreakMode="WordWrap" />
                                                                            </Grid>
                                                                        </Border>

                                                                    </DataTemplate>
                                                                </BindableLayout.ItemTemplate>
                                                            </VerticalStackLayout>

                                                        </VerticalStackLayout>
                                                    </Border>

                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>

                                        <Border
                                            HeightRequest="48"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 24"
                                            BackgroundColor="#4453C7"
                                            Margin="14,0,14,14">

                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference Page}, Path=BindingContext.SubmitSkillCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>

                                            <Label
                                                Text="Submit answers"
                                                FontSize="15"
                                                FontAttributes="Bold"
                                                TextColor="White"
                                                HorizontalTextAlignment="Center"
                                                VerticalTextAlignment="Center" />
                                        </Border>

                                    </VerticalStackLayout>
                                </Border>

                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>