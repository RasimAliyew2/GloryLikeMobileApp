<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MetanetA_MobileApp.View.SignInPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#070A13">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#050714" Offset="0" />
                <GradientStop Color="#101226" Offset="0.55" />
                <GradientStop Color="#070A13" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="22,48,22,30" Spacing="22">

                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border WidthRequest="58" HeightRequest="58" StrokeThickness="0" StrokeShape="RoundRectangle 22">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3545D4" Offset="0" />
                                <GradientStop Color="#985CF2" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label Text="S" FontSize="28" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                    </Border>

                    <Label Text="Welcome back" FontSize="28" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
                    <Label Text="Sign in with your email, username or phone number." FontSize="15" TextColor="#AAB2C5" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 30" Padding="20">
                    <VerticalStackLayout Spacing="14">

                        <Label Text="Sign in" FontSize="22" FontAttributes="Bold" TextColor="#111827" />

                        <Border BackgroundColor="#F3F5FA" Stroke="#E1E6F0" StrokeThickness="1" StrokeShape="RoundRectangle 17" Padding="14,0">
                            <Entry Placeholder="Email, username or phone" Text="{Binding Login}" FontSize="15" TextColor="#111827" PlaceholderColor="#8B95AA" BackgroundColor="Transparent" HeightRequest="50" />
                        </Border>

                        <Border BackgroundColor="#F3F5FA" Stroke="#E1E6F0" StrokeThickness="1" StrokeShape="RoundRectangle 17" Padding="14,0">
                            <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True" FontSize="15" TextColor="#111827" PlaceholderColor="#8B95AA" BackgroundColor="Transparent" HeightRequest="50" />
                        </Border>

                        <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#D92D20" FontSize="13" />

                        <Border HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#3545D4" Offset="0" />
                                    <GradientStop Color="#985CF2" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SignInCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Sign in" TextColor="White" FontAttributes="Bold" FontSize="15" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>

                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#3545D4" />

                        <Grid ColumnDefinitions="*,*" Margin="0,4,0,0">
                            <Label Text="Forgot password?" TextColor="#3545D4" FontAttributes="Bold" FontSize="14">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ForgotPasswordCommand}" />
                                </Label.GestureRecognizers>
                            </Label>

                            <Label Grid.Column="1" Text="Create account" TextColor="#3545D4" FontAttributes="Bold" FontSize="14" HorizontalTextAlignment="End">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding GoToSignUpCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
