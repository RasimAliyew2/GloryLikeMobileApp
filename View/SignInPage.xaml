<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MetanetA_MobileApp.View.SignInPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#050816">

    <ContentPage.Resources>
        <Style x:Key="AuthButtonStyle" TargetType="Button">
            <Setter Property="HeightRequest" Value="56" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#111827" />
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="BorderColor" Value="#E5E7EB" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="22">
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#050816" Offset="0.00" />
                <GradientStop Color="#0B1024" Offset="0.45" />
                <GradientStop Color="#111827" Offset="1.00" />
            </LinearGradientBrush>
        </Grid.Background>

        <VerticalStackLayout Spacing="0">
            <Label
                Text="‹ Back to registration"
                FontSize="14"
                TextColor="#D1D5DB"
                Margin="0,8,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="BackToRegistration_Tapped" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>

        <ScrollView VerticalScrollBarVisibility="Never">
            <VerticalStackLayout
                Spacing="28"
                VerticalOptions="Center"
                Padding="0,56,0,28">

                <VerticalStackLayout Spacing="18" HorizontalOptions="Center">
                    <Border
                        WidthRequest="72"
                        HeightRequest="72"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        BackgroundColor="#FFFFFF"
                        HorizontalOptions="Center">
                        <Border.Shadow>
                            <Shadow Brush="#000000" Opacity="0.28" Radius="20" Offset="0,10" />
                        </Border.Shadow>
                        <Label
                            Text="S"
                            FontSize="34"
                            FontAttributes="Bold"
                            TextColor="#111827"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>

                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Label
                            Text="Build your verified professional identity"
                            FontSize="34"
                            FontAttributes="Bold"
                            TextColor="#FFFFFF"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap" />

                        <Label
                            Text="SkillMatch matches you to jobs by what you can actually do — not just your job titles."
                            FontSize="16"
                            TextColor="#CBD5E1"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap"
                            MaximumWidthRequest="360" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Border
                    BackgroundColor="#FFFFFF"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 30"
                    Padding="18"
                    MaximumWidthRequest="420"
                    HorizontalOptions="Fill">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Opacity="0.22" Radius="24" Offset="0,12" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="12">
                        <Button
                            Text="Continue with Google"
                            Style="{StaticResource AuthButtonStyle}"
                            Clicked="ContinueWithGoogle_Clicked" />

                        <Button
                            Text="Continue with Apple"
                            Style="{StaticResource AuthButtonStyle}"
                            Clicked="ContinueWithApple_Clicked" />

                        <Button
                            Text="Continue with Email"
                            HeightRequest="56"
                            CornerRadius="18"
                            FontSize="16"
                            FontAttributes="Bold"
                            TextColor="#FFFFFF"
                            BackgroundColor="#111827"
                            Clicked="ContinueWithEmail_Clicked" />

                        <Label
                            Margin="8,8,8,0"
                            FontSize="12"
                            TextColor="#6B7280"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="By continuing, you agree to our " />
                                    <Span Text="Terms" TextColor="#111827" FontAttributes="Bold" />
                                    <Span Text=" and " />
                                    <Span Text="Privacy Policy" TextColor="#111827" FontAttributes="Bold" />
                                    <Span Text="." />
                                </FormattedString>
                            </Label.FormattedText>
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Terms_Tapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
