<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MetanetA_MobileApp.View.SignInPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodel="clr-namespace:MetanetA_MobileApp.ViewModel"
    x:DataType="viewmodel:SignInViewModel"
    BackgroundColor="#040814"
    Shell.NavBarIsVisible="False">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#050816" Offset="0.0" />
                <GradientStop Color="#071A32" Offset="0.45" />
                <GradientStop Color="#0D1230" Offset="1.0" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="24,28,24,32" Spacing="22">

                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Start">
                    <Label
                        Text="←"
                        FontSize="22"
                        TextColor="#D7DCEF"
                        VerticalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="BackToRegistration_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <Label
                        Grid.Column="2"
                        Text="Create account"
                        FontSize="14"
                        TextColor="#B9C2D7"
                        VerticalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ShowRegistration_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <VerticalStackLayout Spacing="10" Margin="0,8,0,0">
                    <Border
                        WidthRequest="76"
                        HeightRequest="76"
                        StrokeThickness="0"
                        BackgroundColor="#F5F7FB"
                        StrokeShape="RoundRectangle 24"
                        HorizontalOptions="Center">
                        <Label
                            Text="S"
                            FontSize="34"
                            FontAttributes="Bold"
                            TextColor="#151426"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />
                    </Border>

                    <Label
                        Text="Welcome back"
                        FontSize="38"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />

                    <Label
                        Text="Sign in to continue building your verified professional identity."
                        FontSize="16"
                        TextColor="#B8C3D9"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <Border
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 28"
                    BackgroundColor="#F7F8FC"
                    Padding="18">

                    <VerticalStackLayout Spacing="14">
                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10" Margin="0,2,0,0">
                            <BoxView HeightRequest="1" BackgroundColor="#E4E7EF" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="or" FontSize="13" TextColor="#7B879C" />
                            <BoxView Grid.Column="2" HeightRequest="1" BackgroundColor="#E4E7EF" VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout Spacing="8" Margin="0,2,0,0">
                            <Label Text="Email, username or phone" FontSize="13" TextColor="#5B657B" />
                            <Border
                                BackgroundColor="#EEF2F8"
                                Stroke="#D7DFF0"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 18"
                                Padding="14,6">
                                <Entry
                                    x:Name="LoginEntry"
                                    Text="{Binding Login}"
                                    Placeholder="john@example.com"
                                    Keyboard="Email"
                                    FontSize="15"
                                    TextColor="#111827"
                                    PlaceholderColor="#8E98AE"
                                    ClearButtonVisibility="WhileEditing"
                                    BackgroundColor="Transparent" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Password" FontSize="13" TextColor="#5B657B" />
                            <Grid ColumnDefinitions="*,Auto">
                                <Border
                                    Grid.ColumnSpan="2"
                                    BackgroundColor="#EEF2F8"
                                    Stroke="#D7DFF0"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 18"
                                    Padding="14,6">
                                    <Entry
                                        x:Name="PasswordEntry"
                                        Text="{Binding Password}"
                                        Placeholder="Enter your password"
                                        IsPassword="{Binding IsPasswordHidden}"
                                        FontSize="15"
                                        TextColor="#111827"
                                        PlaceholderColor="#8E98AE"
                                        BackgroundColor="Transparent" />
                                </Border>

                                <Label
                                    Grid.Column="1"
                                    Margin="0,0,16,0"
                                    Text="👁"
                                    FontSize="18"
                                    VerticalTextAlignment="Center"
                                    HorizontalTextAlignment="Center"
                                    TextColor="#6B7280">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding TogglePasswordVisibilityCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </VerticalStackLayout>

                        <Label
                            Text="{Binding ErrorMessage}"
                            TextColor="#D92D20"
                            FontSize="13"
                            LineBreakMode="WordWrap"
                            IsVisible="{Binding FillTheArea}" />

                        <Label
                            Text="{Binding ErrorMessage}"
                            TextColor="#D92D20"
                            FontSize="13"
                            LineBreakMode="WordWrap"
                            IsVisible="{Binding InvalidCredentials}" />

                        <Label
                            Text="Forgot password?"
                            FontSize="14"
                            TextColor="#3545D4"
                            HorizontalOptions="End">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ForgotPassword_Tapped" />
                            </Label.GestureRecognizers>
                        </Label>

                        <Button
                            Text="Sign in"
                            HeightRequest="58"
                            FontSize="17"
                            FontAttributes="Bold"
                            TextColor="White"
                            CornerRadius="18"
                            Clicked="SignIn_Tapped">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#3545D4" Offset="0" />
                                    <GradientStop Color="#985CF2" Offset="1" />
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>

                        <Button
                            Text="Continue with Apple"
                            HeightRequest="54"
                            FontSize="15"
                            FontAttributes="Bold"
                            BackgroundColor="#111827"
                            TextColor="White"
                            CornerRadius="18"
                            Clicked="ContinueApple_Tapped" />

                        <Button
                            Text="Continue with Google"
                            HeightRequest="54"
                            FontSize="15"
                            FontAttributes="Bold"
                            BackgroundColor="#EDE9FE"
                            TextColor="#4C1D95"
                            CornerRadius="18"
                            BorderColor="#C4B5FD"
                            BorderWidth="1"
                            Clicked="ContinueGoogle_Tapped" />
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                    <Label Text="Don't have an account?" FontSize="14" TextColor="#B8C3D9" />
                    <Label Text="Create one" FontSize="14" FontAttributes="Bold" TextColor="White">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="ShowRegistration_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
