<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MetanetA_MobileApp.View.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:MetanetA_MobileApp.Controls"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#030316">

    <ContentPage.Resources>
        <Style x:Key="MutedLabel" TargetType="Label">
            <Setter Property="TextColor" Value="#B8BDD4" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="CardTitle" TargetType="Label">
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="TextColor" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#05051F" Offset="0.00" />
                    <GradientStop Color="#070924" Offset="0.36" />
                    <GradientStop Color="#001E2D" Offset="0.72" />
                    <GradientStop Color="#160A2A" Offset="1.00" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView>
            <VerticalStackLayout Padding="18,22,18,104" Spacing="18">

                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label
                            Text="Good morning"
                            FontSize="13"
                            TextColor="#B8BDD4" />

                        <Label
                            Text="Aigerim "
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="White" />
                    </VerticalStackLayout>

                    <Border
                        Grid.Column="1"
                        WidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="#17172B"
                        Stroke="#262640"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24">

                        <Grid>
                            <Label
                                Text="🔔"
                                FontSize="20"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />

                            <Ellipse
                                WidthRequest="8"
                                HeightRequest="8"
                                Fill="#FF6B8A"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                Margin="0,9,10,0" />
                        </Grid>
                    </Border>
                </Grid>

                <Border
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 30"
                    Padding="20">

                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3539B8" Offset="0" />
                            <GradientStop Color="#6A4DEB" Offset="0.55" />
                            <GradientStop Color="#8C58F0" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid ColumnDefinitions="*,120" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                        <Border
                            Grid.ColumnSpan="2"
                            BackgroundColor="#30FFFFFF"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 18"
                            HorizontalOptions="Start"
                            Padding="12,8">

                            <HorizontalStackLayout Spacing="8">
                                <Label Text="✧" TextColor="White" FontSize="14" />
                                <Label
                                    Text="MATCH STRENGTH"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="White" />
                            </HorizontalStackLayout>
                        </Border>

                        <HorizontalStackLayout Grid.Row="1" Margin="0,28,0,0" Spacing="4" VerticalOptions="Center">
                            <Label
                                Text="88"
                                FontSize="46"
                                FontAttributes="Bold"
                                TextColor="White" />

                            <Label
                                Text="/100"
                                FontSize="30"
                                FontAttributes="Bold"
                                TextColor="#D9D9FF"
                                VerticalTextAlignment="End" />
                        </HorizontalStackLayout>

                        <!-- 88% progress: yaşıl hissə artıq tam dairə yox, yalnız 88% olacaq. -->
                        <controls:CircularProgressView
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,16,0,0"
                            WidthRequest="104"
                            HeightRequest="104"
                            Progress="88"
                            CenterText="88%"
                            SubText="match"
                            StrokeSize="7"
                            ProgressColor="White"
                            TrackColor="#19C789"
                            FillColor="#20FFFFFF"
                            TextColor="White"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <Border
                    BackgroundColor="#101026"
                    Stroke="#24243D"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 26"
                    Padding="18">

                    <Grid ColumnDefinitions="*,46" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                Text="Profile 76% complete"
                                Style="{StaticResource CardTitle}" />

                            <Label
                                Text="Add certifications to unlock 4 more roles"
                                Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            WidthRequest="44"
                            HeightRequest="44"
                            BackgroundColor="#EEF2FF"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22">

                            <Label
                                Text="➜"
                                FontSize="23"
                                FontAttributes="Bold"
                                TextColor="#3342BA"
                                HorizontalTextAlignment="Center"
                                VerticalTextAlignment="Center" />
                        </Border>

                        <Grid Grid.Row="2" Grid.ColumnSpan="2" HeightRequest="9">
                            <Border
                                BackgroundColor="#25253C"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 5" />

                            <Border
                                WidthRequest="256"
                                HorizontalOptions="Start"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 5">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#3545D4" Offset="0" />
                                        <GradientStop Color="#985CF2" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
                    <Border
                        HeightRequest="110"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        Padding="12">

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SkillsCommand}" />
                        </Border.GestureRecognizers>

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3545D4" Offset="0" />
                                <GradientStop Color="#985CF2" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                            <Border WidthRequest="38" HeightRequest="38" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 19">
                                <Label Text="✣" FontSize="18" TextColor="Black" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Text="Skills" FontAttributes="Bold" TextColor="White" FontSize="13" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="1"
                        HeightRequest="110"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        Padding="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3545D4" Offset="0" />
                                <GradientStop Color="#985CF2" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                            <Border WidthRequest="38" HeightRequest="38" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 19">
                                <Label Text="⇧" FontSize="18" TextColor="Black" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Text="Upload CV" FontAttributes="Bold" TextColor="White" FontSize="13" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="2"
                        HeightRequest="110"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 22"
                        Padding="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3545D4" Offset="0" />
                                <GradientStop Color="#985CF2" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <VerticalStackLayout Spacing="12" HorizontalOptions="Center" VerticalOptions="Center">
                            <Border WidthRequest="38" HeightRequest="38" BackgroundColor="#FFFFFF" StrokeThickness="0" StrokeShape="RoundRectangle 19">
                                <Label Text="♙" FontSize="18" TextColor="Black" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Text="Certify" FontAttributes="Bold" TextColor="White" FontSize="13" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" Margin="0,6,0,0">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Active applications" Style="{StaticResource SectionTitle}" />
                        <Label Text="0 in progress" Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>

                    <Label
                        Grid.Column="1"
                        Text="All ›"
                        FontSize="14"
                        TextColor="#8E95FF"
                        VerticalTextAlignment="Center" />
                </Grid>

                <Border
                    BackgroundColor="#0F1025"
                    Stroke="#252641"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    Padding="18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="No active applications yet" Style="{StaticResource CardTitle}" />
                        <Label
                            Text="When you apply to roles, your progress and employer updates will appear here."
                            TextColor="#B8BDD4"
                            FontSize="14"
                            LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Recommended next steps" Style="{StaticResource SectionTitle}" />

                <VerticalStackLayout Spacing="12">
                    <Border BackgroundColor="#101026" Stroke="#24243D" StrokeThickness="1" StrokeShape="RoundRectangle 22" Padding="16">
                        <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="#EEF2FF" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                                <Label Text="✦" FontSize="18" TextColor="#3342BA" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Verify one more skill" Style="{StaticResource CardTitle}" />
                                <Label Text="Increase your match score by adding another verified skill." Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <Border BackgroundColor="#101026" Stroke="#24243D" StrokeThickness="1" StrokeShape="RoundRectangle 22" Padding="16">
                        <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="#E5FFF0" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                                <Label Text="✓" FontSize="18" FontAttributes="Bold" TextColor="#18B66E" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label Text="Complete your profile" Style="{StaticResource CardTitle}" />
                                <Label Text="Add certifications and work evidence to unlock better matches." Style="{StaticResource MutedLabel}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
