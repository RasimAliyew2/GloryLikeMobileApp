<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MetanetA_MobileApp.View.BottomMenu"
    HeightRequest="86"
    BackgroundColor="Transparent">

    <Grid Padding="14,0,14,12"
          VerticalOptions="End">

        <Border
            HeightRequest="74"
            StrokeThickness="1"
            Stroke="#24304A"
            StrokeShape="RoundRectangle 28"
            Padding="10,8">

            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#070B18" Offset="0" />
                    <GradientStop Color="#0D1630" Offset="0.55" />
                    <GradientStop Color="#111827" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid
                ColumnDefinitions="*,*,*,*,*"
                ColumnSpacing="4"
                VerticalOptions="Center">

                <!-- Home -->
                <VerticalStackLayout
                    Grid.Column="0"
                    Spacing="3"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Border
                        WidthRequest="42"
                        HeightRequest="34"
                        StrokeThickness="0"
                        BackgroundColor="#111A2E"
                        StrokeShape="RoundRectangle 17">

                        <ImageButton
                            Source="house_button.png"
                            BackgroundColor="Transparent"
                            Padding="8"
                            Aspect="AspectFit"
                            Command="{Binding HomeCommand}" />
                    </Border>

                    <Label
                        Text="Əsas"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="#D9E2F3"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Jobs -->
                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="3"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Border
                        WidthRequest="42"
                        HeightRequest="34"
                        StrokeThickness="0"
                        BackgroundColor="#111A2E"
                        StrokeShape="RoundRectangle 17">

                        <ImageButton
                            Source="job.png"
                            BackgroundColor="Transparent"
                            Padding="8"
                            Aspect="AspectFit"
                            Command="{Binding ProductsCommand}" />
                    </Border>

                    <Label
                        Text="Jobs"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="#D9E2F3"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Applied -->
                <VerticalStackLayout
                    Grid.Column="2"
                    Spacing="3"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Border
                        WidthRequest="48"
                        HeightRequest="38"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 19">

                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#3545D4" Offset="0" />
                                <GradientStop Color="#985CF2" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <ImageButton
                            Source="briefcase.png"
                            BackgroundColor="Transparent"
                            Padding="9"
                            Aspect="AspectFit"
                            Command="{Binding ApplicationsCommand}" />
                    </Border>

                    <Label
                        Text="Applied"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Profile -->
                <VerticalStackLayout
                    Grid.Column="3"
                    Spacing="3"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Border
                        WidthRequest="42"
                        HeightRequest="34"
                        StrokeThickness="0"
                        BackgroundColor="#111A2E"
                        StrokeShape="RoundRectangle 17">

                        <ImageButton
                            Source="profile.png"
                            BackgroundColor="Transparent"
                            Padding="8"
                            Aspect="AspectFit"
                            Command="{Binding ProfileCommand}" />
                    </Border>

                    <Label
                        Text="Profil"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="#D9E2F3"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

                <!-- Inbox -->
                <VerticalStackLayout
                    Grid.Column="4"
                    Spacing="3"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">

                    <Border
                        WidthRequest="42"
                        HeightRequest="34"
                        StrokeThickness="0"
                        BackgroundColor="#111A2E"
                        StrokeShape="RoundRectangle 17">

                        <ImageButton
                            Source="other_icon.png"
                            BackgroundColor="Transparent"
                            Padding="8"
                            Aspect="AspectFit"
                            Command="{Binding OtherCommand}" />
                    </Border>

                    <Label
                        Text="Inbox"
                        FontSize="10"
                        FontAttributes="Bold"
                        TextColor="#D9E2F3"
                        HorizontalTextAlignment="Center" />
                </VerticalStackLayout>

            </Grid>
        </Border>
    </Grid>
</ContentView>