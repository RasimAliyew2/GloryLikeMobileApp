<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MetanetA_MobileApp.View.SignUpPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#070A13">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#050714" Offset="0" />
                <GradientStop Color="#101226" Offset="0.55" />
                <GradientStop Color="#070A13" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <ScrollView>
            <VerticalStackLayout Padding="22,38,22,30" Spacing="18">

                <HorizontalStackLayout Spacing="8">
                    <Label Text="‹" FontSize="28" TextColor="White" />
                    <Label Text="Sign in" TextColor="#AAB2C5" FontSize="14" VerticalTextAlignment="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding GoToSignInCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </HorizontalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Create your account" FontSize="28" FontAttributes="Bold" TextColor="White" />
                    <Label Text="Your profile and verification scores will be saved to your account." FontSize="15" TextColor="#AAB2C5" />
                </VerticalStackLayout>

                <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 30" Padding="20">
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border BackgroundColor="#F3F5FA" Stroke="#E1E6F0" StrokeThickness="1" StrokeShape="RoundRectangle 17" Padding="14,0">
                                <Entry Placeholder="Name" Text="{Binding Name}" FontSize="15" TextColor="#111827" PlaceholderColor="#8B95AA" BackgroundColor="Transparent" HeightRequest="50" />
                            </Border>

                            <Border Grid.Column="1" BackgroundColor="#F3F5FA" Stroke="#E1E6F0" StrokeThickness="1" StrokeShape="RoundRectangle 17" Padding="14,0">
                                <Entry Placeholder="Surname" Text="{Binding Surname}" FontSize="15" TextColor="#111827" PlaceholderColor="#8B95AA" BackgroundColor="Transparent" HeightRequest="50" />
                            </Border>
                        </Grid>

                        <Border BackgroundColor="#F3F5FA" Stroke="#E1E6F0" StrokeThickness="1" StrokeShape="RoundRectangle 17" Padding="14,0">
                            <Entry Placeholder="Username" Text="{Binding UserName}" FontSize="15" TextColor="#111827" PlaceholderColor="#8B95AA" BackgroundColor="Transparent" HeightRequest="50" />
                        </Border>

                        <Border BackgroundColor="#F3F5FA" Stroke="#E1E6F0" StrokeThickness="1" StrokeShape="RoundRectangle 17" Padding="14,0">
                            <Entry Placeholder="Phone number" Text="{Binding PhoneNumber}" Keyboard="Telephone" FontSize="15" TextColor="#111827" PlaceholderColor="#8B95AA" BackgroundColor="Transparent" HeightRequest="50" />
                        </Border>

                        <Border BackgroundColor="#F3F5FA" Stroke="#E1E6F0" StrokeThickness="1" StrokeShape="RoundRectangle 17" Padding="14,0">
                            <Entry Placeholder="Email" Text="{Binding Email}" Keyboard="Email" FontSize="15" TextColor="#111827" PlaceholderColor="#8B95AA" BackgroundColor="Transparent" HeightRequest="50" />
                        </Border>

                        <Border BackgroundColor="#F3F5FA" Stroke="#E1E6F0" StrokeThickness="1" StrokeShape="RoundRectangle 17" Padding="14,0">
                            <Entry Placeholder="Password" Text="{Binding Password}" IsPassword="True" FontSize="15" TextColor="#111827" PlaceholderColor="#8B95AA" BackgroundColor="Transparent" HeightRequest="50" />
                        </Border>

                        <Border BackgroundColor="#F3F5FA" Stroke="#E1E6F0" StrokeThickness="1" StrokeShape="RoundRectangle 17" Padding="14,0">
                            <Entry Placeholder="Confirm password" Text="{Binding ConfirmPassword}" IsPassword="True" FontSize="15" TextColor="#111827" PlaceholderColor="#8B95AA" BackgroundColor="Transparent" HeightRequest="50" />
                        </Border>

                        <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" TextColor="#D92D20" FontSize="13" />

                        <Border HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 18" Margin="0,4,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#3545D4" Offset="0" />
                                    <GradientStop Color="#985CF2" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RegisterCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="Create account" TextColor="White" FontAttributes="Bold" FontSize="15" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>

                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#3545D4" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
